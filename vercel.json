{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/v1", "destination": "/index.html" },
    { "source": "/v1/", "destination": "/index.html" },
    { "source": "/v1/journey", "destination": "/index.html" },
    { "source": "/v1/journey/", "destination": "/index.html" },
    { "source": "/v1/garage", "destination": "/index.html" },
    { "source": "/v1/garage/", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/shop/", "destination": "/index.html" }
  ]
}
